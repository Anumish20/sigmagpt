# ---- SigmaGPT backend config ----
# Copy this file to `.env` and adjust as needed.

PORT=8080

# MongoDB. Local for dev; use a MongoDB Atlas URI in production.
MONGODB_URI=mongodb://127.0.0.1:27017/sigmagpt

# Ollama server. On a hosted box this is the Ollama instance running there.
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=phi3

# Allowed frontend origin(s), comma-separated.
# Dev: http://localhost:5173
# Prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
